					 <&smi_larb19 &smi_larb20>;
			interrupts = <GIC_SPI 271 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&mmsys_config CLK_MM_SPI_IOMMU>,
				 <&scpsys SCP_SYS_DIS>;
			clock-names = "disp-iommu-ck",
				      "power";
			#iommu-cells = <1>;
		}; */
	};
};

